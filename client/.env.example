# Frontend environment variables
# Copy to .env.local for local overrides

# API base URL
# Local dev: /api (proxied to localhost:5000 via vite.config.ts)
# Production: https://sskk-api.onrender.com/api
VITE_API_URL=/api

# Public site URL (used for SEO canonical links)
# Production: https://sskk-shop.vercel.app
VITE_SITE_URL=http://localhost:5173

# Google Maps embed URL (optional override — defaults to business.ts)
# VITE_GOOGLE_MAPS_EMBED=
